# Copia este archivo como .env para que docker compose lo lea.
# En Render o Cloud Run, estas mismas variables se capturan en el panel del servicio.

# Nivel de detalle de los logs: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Umbral de confianza τ. Vacío = el elegido en el entrenamiento (metadatos del modelo).
UMBRAL_CONFIANZA=

# Orígenes CORS permitidos, separados por coma. Vacío = solo el mismo origen
# (el frontend lo sirve la propia API, así que no hace falta).
ORIGENES_PERMITIDOS=

# Tamaño máximo del cuerpo de una solicitud, en bytes.
TAMANO_MAXIMO_BYTES=65536
